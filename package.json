{
  "name": "tanstack-router-cache",
  "version": "0.1.13",
  "description": "Route view caching for TanStack Router.",
  "keywords": [
    "react",
    "route-cache",
    "route-state",
    "router",
    "tanstack-router",
    "view-cache"
  ],
  "homepage": "https://github.com/santiago-ramos-02/tanstack-router-cache#readme",
  "bugs": {
    "url": "https://github.com/santiago-ramos-02/tanstack-router-cache/issues"
  },
  "license": "MIT",
  "author": "Santiago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiago-ramos-02/tanstack-router-cache.git"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run clean && rolldown -c && tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "oxlint src scripts .github/scripts rolldown.config.ts",
    "lint:fix": "oxlint --fix src scripts .github/scripts rolldown.config.ts",
    "check": "bun run lint && bun run typecheck && bun run build && bun run pack:dry-run",
    "pack:dry-run": "npm pack --dry-run",
    "release": "node scripts/release.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun run lint && bun run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.168.14 <2.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "packageManager": "bun@1.3.14"
}
