{
  "name": "tanstack-router-cache",
  "version": "0.1.14",
  "description": "Route view caching for TanStack Router.",
  "keywords": [
    "react",
    "route-cache",
    "route-state",
    "router",
    "tanstack-router",
    "view-cache"
  ],
  "homepage": "https://github.com/santiago-ramos-02/tanstack-router-cache#readme",
  "bugs": {
    "url": "https://github.com/santiago-ramos-02/tanstack-router-cache/issues"
  },
  "license": "MIT",
  "author": "Santiago",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiago-ramos-02/tanstack-router-cache.git"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "mappstock-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run clean && rolldown -c && tsrs",
    "typecheck": "bun check --no-script -p tsconfig.json && bun check --no-script -p test/tsconfig.json && bun check --no-script -p tsconfig.node.json",
    "clean": "rm -rf dist",
    "lint": "oxlint src scripts test .github/scripts rolldown.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src scripts test .github/scripts rolldown.config.ts vitest.config.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run pack:dry-run",
    "test": "vitest run",
    "pack:dry-run": "bun pm pack --dry-run",
    "release": "bun scripts/release.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run lint && bun run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.15",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.170.31 <2.0.0",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  },
  "packageManager": "bun@1.4.4"
}
